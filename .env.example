# Required. PostgreSQL is deployed independently and must be reachable from
# the trade-log-server container. compose.yaml maps host.docker.internal to
# the Docker host on Linux. Create a dedicated database/user and grant that
# user permission to create and alter objects in its schema.
DATABASE_URL=postgres://robotech:replace-password@host.docker.internal:5432/robotech

# Required. The receiver must accept POST requests from the container.
EVENT_WEBHOOK_URL=http://host.docker.internal:9000/events
# Required, at least 16 characters. Replace before use.
EVENT_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Optional runtime settings.
HTTP_PORT=8080
RUST_LOG=info
DEFAULT_HISTORY_LOOKBACK_SECONDS=604800
HTTP_OVERLAP_SECONDS=120
HTTP_RECONCILE_INTERVAL_SECONDS=30
MAX_MONITORED_ADDRESSES=10
