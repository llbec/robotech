# Required. The receiver must accept POST requests from the container.
EVENT_WEBHOOK_URL=http://host.docker.internal:9000/events
# Required, at least 16 characters. Replace before use.
EVENT_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Optional runtime settings.
POSTGRES_PASSWORD=robotech-local
HTTP_PORT=8080
RUST_LOG=info
DEFAULT_HISTORY_LOOKBACK_SECONDS=604800
HTTP_OVERLAP_SECONDS=120
HTTP_RECONCILE_INTERVAL_SECONDS=30
MAX_MONITORED_ADDRESSES=10
